<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:SourceGitAutoUpdater.ViewModels" xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
 x:Class="SourceGitAutoUpdater.Views.UpdateWindow" x:DataType="vm:UpdateViewModel"
 Title="{DynamicResource Text.SelfUpdate.Title}" Icon="/App.ico" SizeToContent="WidthAndHeight"
 CanResize="False" WindowStartupLocation="CenterScreen" BorderThickness="1" SystemDecorations="None">
 <Grid RowDefinitions="28,Auto">
  <Grid x:Name="CustomTitleBar" Grid.Row="0" Background="{DynamicResource Brush.TitleBar}">
   <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}" Background="Transparent" PointerPressed="BeginMoveWindow"/>
   <Path Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" Data="{StaticResource Icons.SoftwareUpdate}" IsHitTestVisible="False"/>
   <TextBlock Classes="bold" Text="{DynamicResource Text.SelfUpdate.Title}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
   <Button Classes="caption_button" HorizontalAlignment="Right" Click="CloseWindow" IsEnabled="{Binding CanClose}">
    <Path Width="9" Height="9" Margin="0,4,2,0" Data="{StaticResource Icons.Window.Close}"/>
   </Button>
  </Grid>
  <StackPanel Grid.Row="1" Orientation="Vertical" Margin="16,8" MinWidth="500">
   <TextBlock x:Name="BootstrapHeading" IsVisible="{Binding IsFirstInstall}" Text="{Binding SetupLabel}" FontSize="14" FontWeight="Bold" Margin="0,8" HorizontalAlignment="Center"/>
   <StackPanel x:Name="ReleaseHeader" IsVisible="{Binding HasRelease}" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
    <Path Width="14" Height="14" Data="{StaticResource Icons.Info}" Fill="Green"/>
    <TextBlock Margin="8,0,0,0" FontWeight="Bold" FontSize="14" Text="{DynamicResource Text.SelfUpdate.Available}"/>
    <Border Margin="4,0,0,0" Height="20" CornerRadius="10" Background="{DynamicResource Brush.Accent}" Effect="drop-shadow(0 0 6 #40000000)">
     <TextBlock Margin="8,0" Text="{Binding TagName}" FontSize="12" Foreground="White"/>
    </Border>
   </StackPanel>
   <StackPanel x:Name="ReleaseMetadata" IsVisible="{Binding HasRelease}">
   <TextBlock Margin="0,8,0,0"><Run Text="{DynamicResource Text.SelfUpdate.CurrentVersion}" FontWeight="Bold" Foreground="{DynamicResource Brush.FG2}"/><Run Text="{Binding CurrentVersion}"/></TextBlock>
   <TextBlock Margin="0,2,0,0"><Run Text="{DynamicResource Text.SelfUpdate.ReleaseDate}" FontWeight="Bold" Foreground="{DynamicResource Brush.FG2}"/><Run Text="{Binding ReleaseDate}"/></TextBlock>
   </StackPanel>
   <Border x:Name="ReleaseNotesPanel" IsVisible="{Binding HasRelease}" Width="500" Height="280" MaxHeight="400" Margin="0,8,0,0" Background="{DynamicResource Brush.Contents}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}">
    <ae:TextEditor x:Name="ReleaseNotes" IsReadOnly="True" ShowLineNumbers="False" WordWrap="True" Background="Transparent" Foreground="{DynamicResource Brush.FG1}" FontFamily="{DynamicResource Fonts.Monospace}" FontSize="{DynamicResource Font.Size}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
   </Border>
   <StackPanel IsVisible="{Binding IsBusy}" Margin="0,10,0,0" Spacing="6">
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="500"/>
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Height="4"/>
   </StackPanel>
   <StackPanel x:Name="ChoiceButtons" IsVisible="{Binding ShowChoices}" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
    <Button Classes="flat primary" Height="30" Click="Update" IsEnabled="{Binding CanChoose}"><StackPanel Orientation="Horizontal"><Path Width="12" Height="12" Data="{StaticResource Icons.Pull}" Fill="{DynamicResource AccentButtonForeground}"/><TextBlock Text="{Binding UpdateLabel}" Margin="8,0,0,0" Foreground="{DynamicResource AccentButtonForeground}"/></StackPanel></Button>
    <Button Classes="flat" Height="30" Click="Skip" IsEnabled="{Binding CanChoose}"><StackPanel Orientation="Horizontal"><Path Width="12" Height="12" Data="{StaticResource Icons.File.Ignore}"/><TextBlock Text="{DynamicResource Text.SelfUpdate.IgnoreThisVersion}" Margin="8,0,0,0"/></StackPanel></Button>
   </StackPanel>
   <Button x:Name="CancelButton" IsVisible="{Binding ShowCancel}" IsEnabled="{Binding CanCancel}" Classes="flat" Content="{Binding CancelLabel}" Click="Cancel" HorizontalAlignment="Center" Height="30" Margin="0,8,0,0" Padding="16,0"/>
   <Button x:Name="AttributionLink" Classes="attribution" Click="OpenSourceGit" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="0" Background="Transparent" BorderThickness="0">
    <TextBlock Text="{Binding Attribution}" FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextDecorations="Underline"/>
   </Button>
  </StackPanel>
 </Grid>
</Window>




