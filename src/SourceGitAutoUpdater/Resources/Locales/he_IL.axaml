<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<x:String x:Key="Text.Cancel" xml:space="preserve">ביטול</x:String>
<x:String x:Key="Text.Close" xml:space="preserve">סגור</x:String>
<x:String x:Key="Text.No" xml:space="preserve">לא</x:String>
<x:String x:Key="Text.SelfUpdate.Available" xml:space="preserve">גרסה חדשה של התוכנה זמינה: </x:String>
